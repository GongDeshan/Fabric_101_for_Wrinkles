// ABS shear energy, 2026-10-07. Retain generated signed formulas above for
// traceability; wrappers use their k33_1=0 part and add exact ABS derivatives.
// W_shear = .5*(k33_0+k33_1*abs(Guv))*(Guv-p_uv)^2.
// At Guv=0 with nonzero p_uv this energy is nonsmooth: use sign(0)=0
// (a convention, not a classical Hessian at that kink).
template<typename T>
__host__ __device__ void AbsShearGeometry(
    T& q, Eigen::Vector<T,9>& dq, Eigen::Matrix<T,9,9>& Hq,
    const Eigen::Vector<T,9>& x, const Eigen::Vector<T,6>& X)
{
    Eigen::Matrix<T,2,2> Dm, inverse;
    Dm.col(0)=X.template segment<2>(2)-X.template segment<2>(0);
    Dm.col(1)=X.template segment<2>(4)-X.template segment<2>(0);
    const T det=Dm(0,0)*Dm(1,1)-Dm(0,1)*Dm(1,0);
    inverse(0,0)=Dm(1,1)/det; inverse(0,1)=-Dm(0,1)/det;
    inverse(1,0)=-Dm(1,0)/det; inverse(1,1)=Dm(0,0)/det;
    Eigen::Matrix<T,3,2> Ds;
    Ds.col(0)=x.template segment<3>(3)-x.template segment<3>(0);
    Ds.col(1)=x.template segment<3>(6)-x.template segment<3>(0);
    const Eigen::Matrix<T,3,2> F=Ds*inverse;
    Eigen::Matrix<T,9,3> Du, Dv;
    const Eigen::Matrix<T,3,3> Id=Eigen::Matrix<T,3,3>::Identity();
    Du.template block<3,3>(0,0)=(-inverse(0,0)-inverse(1,0))*Id;
    Du.template block<3,3>(3,0)=inverse(0,0)*Id;
    Du.template block<3,3>(6,0)=inverse(1,0)*Id;
    Dv.template block<3,3>(0,0)=(-inverse(0,1)-inverse(1,1))*Id;
    Dv.template block<3,3>(3,0)=inverse(0,1)*Id;
    Dv.template block<3,3>(6,0)=inverse(1,1)*Id;
    q=T(.5)*F.col(0).dot(F.col(1));
    dq=T(.5)*(Du*F.col(1)+Dv*F.col(0));
    Hq=T(.5)*(Du*Dv.transpose()+Dv*Du.transpose());
}
template<typename T>
__host__ __device__ void StVKFrictionPlasticNonlinearShearEnergy(
    T& E, const T& k11, const T& k12, const T& k22,
    const T& k33_0, const T& k33_1, const T& kf_33,
    const T& ach_uu, const T& ach_vv, const T& ach_uv,
    const T& p_uu, const T& p_vv, const T& p_uv,
    const Eigen::Vector<T, 9>& x, const Eigen::Vector<T, 6>& X)
{
    StVKFrictionPlasticNonlinearShearEnergySignedLegacy(E,k11,k12,k22,k33_0,T(0),kf_33,ach_uu,ach_vv,ach_uv,p_uu,p_vv,p_uv,x,X);
    Eigen::Matrix<T,2,2> G; Strain(G,x,X);
    const T q=G(0,1), z=q-p_uv;
    E+=T(.5)*k33_1*std::abs(q)*z*z;
}
template<typename T>
__host__ __device__ void StVKFrictionPlasticNonlinearShearGradient(
    Eigen::Vector<T,9>& gradient, const T& k11, const T& k12, const T& k22,
    const T& k33_0, const T& k33_1, const T& kf_33,
    const T& ach_uu, const T& ach_vv, const T& ach_uv,
    const T& p_uu, const T& p_vv, const T& p_uv,
    const Eigen::Vector<T, 9>& x, const Eigen::Vector<T, 6>& X)
{
    StVKFrictionPlasticNonlinearShearGradientSignedLegacy(gradient,k11,k12,k22,k33_0,T(0),kf_33,ach_uu,ach_vv,ach_uv,p_uu,p_vv,p_uv,x,X);
    T q; Eigen::Vector<T,9> dq; Eigen::Matrix<T,9,9> Hq;
    AbsShearGeometry(q,dq,Hq,x,X);
    const T z=q-p_uv;
    const T tau=k33_1*(std::abs(q)*z+T(.5)*sign(q)*z*z);
    gradient+=tau*dq;
}
template<typename T>
__host__ __device__ void StVKFrictionPlasticNonlinearShearHessian(
    Eigen::Matrix<T,9,9>& H, const T& k11, const T& k12, const T& k22,
    const T& k33_0, const T& k33_1, const T& kf_33,
    const T& ach_uu, const T& ach_vv, const T& ach_uv,
    const T& p_uu, const T& p_vv, const T& p_uv,
    const Eigen::Vector<T, 9>& x, const Eigen::Vector<T, 6>& X)
{
    StVKFrictionPlasticNonlinearShearHessianSignedLegacy(H,k11,k12,k22,k33_0,T(0),kf_33,ach_uu,ach_vv,ach_uv,p_uu,p_vv,p_uv,x,X);
    T q; Eigen::Vector<T,9> dq; Eigen::Matrix<T,9,9> Hq;
    AbsShearGeometry(q,dq,Hq,x,X);
    const T z=q-p_uv;
    const T tau=k33_1*(std::abs(q)*z+T(.5)*sign(q)*z*z);
    const T tangent=k33_1*(std::abs(q)+T(2)*sign(q)*z);
    H+=tangent*(dq*dq.transpose())+tau*Hq;
}

